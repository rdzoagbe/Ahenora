{
  "expo": {
    "name": "Ahenora",
    "slug": "household-coo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "householdcoo",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/e84e02e4-5335-433f-a39c-3539c473a0dd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.householdcoo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ahenora uses the camera only when you choose Scan to capture household documents, school letters, appointment cards, or bills.",
        "NSPhotoLibraryUsageDescription": "Ahenora uses your photo library only when you choose a photo to scan or attach to a household document."
      }
    },
    "android": {
      "package": "com.householdcoo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ahenora uses your photo library only when you choose a photo to scan or attach to a household document.",
          "cameraPermission": "Ahenora uses the camera only when you choose Scan to capture household documents, school letters, appointment cards, or bills."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/monochrome.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF6A2F"
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Household-COO/app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e84e02e4-5335-433f-a39c-3539c473a0dd"
      }
    }
  }
}