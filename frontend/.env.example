# Ahenora frontend environment
# Copy this file to .env and replace the placeholders with real values.

# Backend API used by the Expo app.
EXPO_PUBLIC_BACKEND_URL=https://household-coo-production.up.railway.app

# Google OAuth client IDs (Google Cloud project: 243255248169).
#
# WEB client ID — type "Web application" in Google Cloud Console.
# Used on all platforms for ID token audience and on web/iOS for the OAuth flow.
# Backend env var GOOGLE_WEB_CLIENT_ID must match this value.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=243255248169-cei972lc7kmfig6tmjb6l2nlmgqkjf22.apps.googleusercontent.com

# ANDROID client ID — type "Android" in Google Cloud Console.
# Only used by the browser-based fallback flow (non-Android platforms ignore it).
# The native Google Sign-In SDK on Android uses the WEB client ID above.
# Must have: package com.householdcoo.app + SHA-1 matching your signing key.
# Get your SHA-1: keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey -storepass android
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=243255248169-ike4t51ha6o8c5rcgsp7mvke2g5t67ol.apps.googleusercontent.com
