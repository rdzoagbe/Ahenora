# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=household_coo

# ─── Google OAuth & API ──────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_API_KEY=

# ─── Facebook OAuth ──────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Sessions & Invites ─────────────────────────────────────────────────────
SESSION_DAYS=7
INVITE_DAYS=14
INVITE_BASE_URL=householdcoo:///

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
INVITE_FROM_EMAIL=noreply@household-coo.app
INVITE_REPLY_TO=support@household-coo.app
APP_NAME=Ahenora

# ─── Security ────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://household-coo.app,householdcoo://,exp://
ADMIN_EMAILS=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20

# ─── Billing: Stripe web checkout (web / iPhone, where store billing can't run) ─
# Leave blank to keep card checkout OFF (the pricing screen falls back to
# pointing web users at Google Play). Set all four to turn it on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Family tier (€6.99 / €49.99)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Household tier (€14.99 / €149.99) — leave blank to keep Household web-checkout
# off; the plans screen still shows it and points buyers to the app/Google Play.
STRIPE_PRICE_HOUSEHOLD_MONTHLY=
STRIPE_PRICE_HOUSEHOLD_YEARLY=
# Where Stripe returns the customer after checkout (defaults to INVITE_BASE_URL,
# then https://ahenora.com/app). No trailing slash needed.
PUBLIC_APP_URL=https://ahenora.com/app

# ─── Misc ────────────────────────────────────────────────────────────────────
MAX_VOICE_AUDIO_BYTES=12582912
PORT=8000
